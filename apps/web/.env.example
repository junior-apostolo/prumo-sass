# Segredo para assinar e verificar JWTs
# Gere um novo para produção: openssl rand -hex 64
JWT_SECRET=

# URL da API backend (Fastify) — configure após deploy da API no Railway
NEXT_PUBLIC_API_URL=http://localhost:3001

# Número de WhatsApp (formato internacional, só dígitos, ex: 5511912345678)
# usado no CTA de upgrade do alerta de estouro de orçamento (>80% consumido).
# Enquanto vazio, o CTA fica oculto (F-FINANCEIRO-UPGRADE).
NEXT_PUBLIC_UPGRADE_WHATSAPP_NUMBER=
